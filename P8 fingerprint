8: Fingerprint Sensor with Raspberry Pi

import time
import board
import adafruit_fingerprint
import serial

uart = serial.Serial("/dev/ttyUSB0", baudrate=57600, timeout=1)
finger = adafruit_fingerprint.Adafruit_Fingerprint(uart)


def get_fingerprint():
    print("Waiting for image...")

    while finger.get_image() != adafruit_fingerprint.OK:
        pass

    print("Templating...")

    if finger.image_2_tz(1) != adafruit_fingerprint.OK:
        return False

    return True


def enroll_finger(location):
    for fingerimg in range(1, 3):
        if fingerimg == 1:
            print("Place finger on sensor...", end="")
        else:
            print("Place same finger again...", end="")

        while True:
            result = finger.get_image()

            if result == adafruit_fingerprint.OK:
                print("Image taken")
                break
            elif result == adafruit_fingerprint.NOFINGER:
                continue
            else:
                print("Other error")
                return False

        print("Templating...", end="")

        if finger.image_2_tz(fingerimg) != adafruit_fingerprint.OK:
            print("Template error")
            return False

        if fingerimg == 1:
            print("Remove finger")
            time.sleep(1)

            while finger.get_image() != adafruit_fingerprint.NOFINGER:
                pass

    if finger.create_model() != adafruit_fingerprint.OK:
        print("Error creating model")
        return False

    if finger.store_model(location) == adafruit_fingerprint.OK:
        print("Fingerprint stored successfully")
        return True

    print("Failed to store fingerprint")
    return False


def get_num():
    while True:
        try:
            i = int(input("Enter ID (1-127): "))
            if 1 <= i <= 127:
                return i
            print("Enter a number between 1 and 127")
        except ValueError:
            print("Invalid input")


while True:
    if finger.read_templates() != adafruit_fingerprint.OK:
        print("Failed to read templates")

    print("\nFingerprint Templates:", finger.templates)
    print("e - Enroll fingerprint")
    print("f - Find fingerprint")
    print("d - Delete fingerprint")
    print("q - Quit")

    choice = input("Enter choice: ").lower()

    if choice == "e":
        enroll_finger(get_num())

    elif choice == "f":
        if get_fingerprint():
            if finger.finger_search() == adafruit_fingerprint.OK:
                print("Fingerprint detected. ID:", finger.finger_id)
            else:
                print("Fingerprint not found")

    elif choice == "d":
        location = get_num()

        if finger.delete_model(location) == adafruit_fingerprint.OK:
            print("Fingerprint deleted")
        else:
            print("Failed to delete fingerprint")

    elif choice == "q":
        break

    else:
        print("Invalid choice")
